{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gareji Board",
  "version": "0.1.0",
  "identifier": "ai.gareji.board",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gareji Board",
        "width": 1456,
        "height": 810,
        "minWidth": 1024,
        "minHeight": 576,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
